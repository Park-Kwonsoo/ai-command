#!/usr/bin/env bash
set -euo pipefail

provider="${AI_CMD_PROVIDER:-claude}"
model="${AI_CMD_MODEL:-claude-haiku-4-5}"
request="${*:-}"

if [[ -z "${request// }" ]]; then
  printf '%s\n' "자연어 요청이 누락되었습니다. 변환할 요청을 보내 주세요." >&2
  exit 1
fi

prompt="Convert the following natural language request into exactly one safe macOS zsh command.

Rules:
- Return only the final shell command.
- No explanation.
- No markdown.
- No code fences.
- Prefer portable macOS/zsh-friendly commands.
- Do not use interactive tools unless explicitly requested.
- If the request is ambiguous, choose the most reasonable read-only/default-safe command.

Request: $request"

case "$provider" in
  codex)
    out_file="${TMPDIR:-/tmp}/codex-last-message.txt"
    rm -f "$out_file"

    codex exec \
      --skip-git-repo-check \
      -o "$out_file" \
      "$prompt" \
      >/dev/null 2>/dev/null

    [[ -f "$out_file" ]] || exit 1
    cat "$out_file"
    ;;
  claude)
    claude -p \
      --model "$model" \
      "$prompt" \
      2>/dev/null
    ;;
  *)
    printf '%s\n' "지원하지 않는 provider입니다: $provider" >&2
    exit 1
    ;;
esac